extends baseEmail

block content
  p Hi #{firstName},
  p Thank you for signing up with EventEase! Please verify your email address by clicking the button below.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${verificationUrl}`, target='_blank') Verify Email Address
  p If you didn't create an account with EventEase, please ignore this email.
  p - The EventEase Team
