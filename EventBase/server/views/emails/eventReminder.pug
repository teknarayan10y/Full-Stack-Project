extends baseEmail

block content
  p Hi #{firstName},
  p This is a friendly reminder about the upcoming event "#{eventName}"!
  
  .event-details(style='margin: 20px 0; padding: 15px; background-color: #f8f9fa; border-radius: 4px;')
    h3(style='margin-top: 0;') #{eventName}
    p(style='margin-bottom: 5px;') 
      strong When: 
      | #{eventDate} at #{eventTime}
    if eventLocation
      p(style='margin-bottom: 5px;')
        strong Where: 
        | #{eventLocation}
    if eventDescription
      p(style='margin: 10px 0 0;') #{eventDescription}
  
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') View Event Details
  
  p We're looking forward to seeing you there!
  p - The EventEase Team
